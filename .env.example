# Curriculum Mapping Tool — Compose environment template.
#
# Copy this file to ".env" (same directory as compose.yaml) and edit as needed.
# Docker Compose reads a sibling ".env" automatically for ${...} interpolation.
# Real ".env" files are gitignored; only this template is tracked.

# Host port to publish the app on (the container always listens on 8080).
CMT_PORT=8080

# Image to run. Default is the latest multi-arch build from GHCR.
# Pin an immutable tag for reproducible, rollback-friendly deploys, e.g.:
#   CMT_IMAGE=ghcr.io/authortom/curriculum-mapping-tool:sha-be1067e
CMT_IMAGE=ghcr.io/authortom/curriculum-mapping-tool:latest


# ---- First admin account ---------------------------------------------------
# Used once, when the database is empty. The account is created active with the
# admin role and must change its password at first sign-in.

ADMIN_EMAIL=admin@localhost

# Leave blank to have a random password generated and printed once to
# `docker compose logs web`. Set it to choose your own.
ADMIN_PASSWORD=


# ---- Sessions --------------------------------------------------------------
# Signs the session cookie. Leave blank and one is generated on first boot and
# stored in the data volume, so logins survive restarts. Set it explicitly to
# rotate the secret or to run more than one replica against shared storage:
#   openssl rand -hex 32
SESSION_SECRET=

# Session cookies are marked Secure whenever NODE_ENV=production (it is, in the
# image), so serve this behind a TLS-terminating reverse proxy. The app already
# trusts X-Forwarded-* headers.


# ---- Demo data -------------------------------------------------------------
# Seeds the abridged sample curricula plus five demo accounts that all share the
# published password "demo1234" (admin@demo.nhs.uk, educator@, manager@, qa@,
# trainee@). Off by default. Only enable it on a throwaway instance that nobody
# else can reach — never on anything holding real trainee data.
CMT_SEED_DEMO=false


# ---- Email (optional) ------------------------------------------------------
# Without SMTP_HOST the app still works; notifications (QA decisions, new
# registrations, password resets) are written to the log instead of sent.

# SMTP_HOST=smtp.example.nhs.uk
# SMTP_PORT=587
# SMTP_SECURE=false                  # true for implicit TLS (port 465)
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Curriculum Mapping Tool <no-reply@yourtrust.nhs.uk>
# APP_URL=https://curriculum.yourtrust.nhs.uk   # linked at the foot of emails


# ---- Where data lives ------------------------------------------------------
# Inside the container this is /data (a volume — see compose.yaml), holding
# app.db and the session secret. Change it only if you also change the mount.
# DATA_DIR=/data


# ---- A note on access ------------------------------------------------------
# Anyone who can reach this instance can register an account, but registrations
# land as "pending" and an admin must approve them before they can sign in.
# The curriculum content seeded by CMT_SEED_DEMO is an abridged sample — enter
# the full official frameworks via Admin → Curricula before real use.
